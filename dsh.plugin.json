{
  "$schema": "https://deepseek.com/harness/schemas/dsh-plugin/v1.json",
  "id": "deepseek-companion",
  "name": "DeepSeek Companion",
  "version": "0.4.0",
  "description": "DeepSeek Harness 官方伴侣插件：对话智能导出、上下文交接摘要（分层压缩 + 血缘图谱 + 上下文压力监测）、API 成本优化（动态计价 + 预测性成本智能）、全局对话检索、本地语义检索（混合排序 + 查询智能 + 时序感知 + 质量诊断 + 反馈学习 + 多样性重排 + 知识地图 + 查询建议 + 命中解释 + 零命中救援）、对话知识资产（实体图谱 + 关联会话 + 主题趋势）、跨会话知识合成（Deep Research）。",
  "author": "DeepSeek Companion Contributors",
  "license": "MIT",
  "homepage": "https://github.com/beijingwahw/dsh-companion",
  "repository": {
    "type": "git",
    "url": "https://github.com/beijingwahw/dsh-companion.git"
  },
  "keywords": [
    "export",
    "handoff",
    "cost",
    "search",
    "retrieval",
    "knowledge",
    "synthesis",
    "deepseek",
    "companion"
  ],
  "engine": {
    "harness": ">=0.1.0",
    "cordis": ">=4.0.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "entry": {
    "host": "./lib/index.js",
    "client": "./lib/client/index.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    }
  },
  "modules": [
    { "id": "export", "name": "对话智能导出", "optional": true, "defaultEnabled": true },
    { "id": "handoff", "name": "上下文交接摘要", "optional": true, "defaultEnabled": true },
    { "id": "cost", "name": "API 成本优化（开发者模式）", "optional": true, "defaultEnabled": true },
    { "id": "search", "name": "全局对话检索", "optional": true, "defaultEnabled": true },
    { "id": "retrieval", "name": "本地语义检索（混合排序 + 自适应学习 + 体验闭环）", "optional": true, "defaultEnabled": true },
    { "id": "knowledge", "name": "对话知识资产（实体图谱）", "optional": true, "defaultEnabled": true },
    { "id": "synthesis", "name": "跨会话知识合成（Deep Research）", "optional": true, "defaultEnabled": true }
  ],
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "manifest.json",
    "dsh.plugin.json"
  ],
  "bundle": {
    "patch": "./cordis.patch.yml"
  },
  "client": {
    "platform": "web",
    "inject": [
      "@deepseek-ai/dsh-client-runtime",
      "@deepseek-ai/dsh-client-ui-conversation",
      "@deepseek-ai/dsh-client-ui-primitives",
      "@deepseek-ai/dsh-client-locale"
    ]
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.0.1-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
