{
  "name": "dsh-companion",
  "version": "0.4.0",
  "description": "DeepSeek Companion — DeepSeek Harness 官方伴侣插件：对话智能导出、上下文交接摘要、API 成本优化、全局对话检索、本地语义检索、对话知识资产、跨会话知识合成。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "keywords": [
    "deepseek",
    "dsh-plugin",
    "companion",
    "export",
    "handoff",
    "cost-optimization",
    "search",
    "semantic-retrieval",
    "knowledge-graph",
    "deep-research"
  ],
  "homepage": "https://github.com/beijingwahw/dsh-companion",
  "repository": {
    "type": "git",
    "url": "https://github.com/beijingwahw/dsh-companion.git"
  },
  "bugs": {
    "url": "https://github.com/beijingwahw/dsh-companion/issues"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "manifest.json",
    "dsh.plugin.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --expose-internals --import tsx ./node_modules/@deepseek-ai/cordis/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/run-all.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.0.1-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-hmr": "^1.0.16",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/cordis-plugin-logger-console": "^1.0.1",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/dsh-storage-domain": ">=0.0.1-0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "packageManager": "pnpm@10.34.5"
}
